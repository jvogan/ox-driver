{
  "version": 1,
  "id": "opencode-ambient",
  "status": "active",
  "harness": "opencode",
  "tier": "trusted-host",
  "launcher": {
    "command": "opencode",
    "versionArgs": ["--version"]
  },
  "route": { "source": "launcher" },
  "defaults": {
    "timeoutSeconds": 3600,
    "reportOnlyCostUsdMicros": 50000
  },
  "pricingPolicy": "from-launcher",
  "credentialPolicy": "from-installed-harness",
  "notice": "Use the installed OpenCode launcher, its active route, normal tools, and existing authentication."
}
