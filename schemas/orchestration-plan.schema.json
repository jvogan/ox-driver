{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ox-driver.dev/schemas/orchestration-plan.schema.json",
  "title": "Ox Driver orchestration plan",
  "description": "Declares heterogeneous lanes validated before the first provider call.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lanes"],
  "properties": {
    "version": { "const": 1 },
    "lanes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/lane" }
    }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" },
    "text": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S" },
    "absolutePath": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "pattern": "^(?:/|[A-Za-z]:[\\\\/])[^\\u0000]*$" }
      ]
    },
    "scopePath": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$))[^\\u0000]+$" }
      ]
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "objective", "workerPath"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "role": { "$ref": "#/$defs/name" },
        "objective": { "$ref": "#/$defs/text" },
        "workerPath": { "$ref": "#/$defs/absolutePath" },
        "harness": { "enum": ["opencode", "pi", "omp"] },
        "writerPolicy": { "enum": ["read-only", "one-writer"] },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "route": { "$ref": "#/$defs/name" },
        "agent": { "$ref": "#/$defs/name" },
        "childAgents": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "ownedPaths": { "type": "array", "items": { "$ref": "#/$defs/scopePath" }, "uniqueItems": true },
        "excludedPaths": { "type": "array", "items": { "$ref": "#/$defs/scopePath" }, "uniqueItems": true },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "costCeilingUsd": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "title": "read-only is available on Pi and OMP lanes",
          "if": { "required": ["writerPolicy"], "properties": { "writerPolicy": { "const": "read-only" } } },
          "then": { "required": ["harness"], "properties": { "harness": { "enum": ["pi", "omp"] } } }
        },
        {
          "title": "a Pi writer lane declares at least one owned path",
          "if": {
            "required": ["harness", "writerPolicy"],
            "properties": { "harness": { "const": "pi" }, "writerPolicy": { "const": "one-writer" } }
          },
          "then": { "required": ["ownedPaths"], "properties": { "ownedPaths": { "minItems": 1 } } }
        },
        {
          "title": "a read-only lane owns no paths",
          "if": {
            "required": ["writerPolicy"],
            "properties": { "writerPolicy": { "const": "read-only" } }
          },
          "then": { "properties": { "ownedPaths": { "maxItems": 0 } } }
        },
        {
          "title": "read-only Pi lanes run no shell acceptance",
          "if": {
            "required": ["harness"],
            "properties": { "harness": { "const": "pi" }, "writerPolicy": { "not": { "const": "one-writer" } } }
          },
          "then": { "properties": { "checks": { "maxItems": 0 } } }
        },
        {
          "title": "child agents remain available only for OpenCode lanes",
          "if": { "required": ["harness"], "properties": { "harness": { "enum": ["pi", "omp"] } } },
          "then": { "properties": { "childAgents": { "maxItems": 0 } } }
        },
        {
          "title": "OMP remains read-only",
          "if": { "required": ["harness"], "properties": { "harness": { "const": "omp" } } },
          "then": { "properties": { "writerPolicy": { "const": "read-only" }, "ownedPaths": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
