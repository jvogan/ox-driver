#!/bin/bash
set -euo pipefail

export PATH=@TRUSTED_PATH@
export HOME=@TRUSTED_HOME@
export TMPDIR=/tmp
REAL_PI=@REAL_PI@
AGENT_DIR=@AGENT_DIR@
EXPECTED_PROVIDER="openrouter"
EXPECTED_MODEL="stealth/ox-alpha"
EXPECTED_THINKING="max"
SAFETY_EXTENSION="$AGENT_DIR/extensions/pi-safety.ts"
RESILIENCE_EXTENSION="$AGENT_DIR/extensions/pi-resilience.ts"
SANDBOX_EXTENSION="$AGENT_DIR/extensions/sandbox/index.ts"
SANDBOX_POLICY="$AGENT_DIR/extensions/sandbox.json"
SAFETY_POLICY="$AGENT_DIR/extensions/pi-safety.json"
SENSITIVE_PATHS="$AGENT_DIR/extensions/sandbox/sensitive-paths.ts"
SUBAGENT_EXTENSION="$AGENT_DIR/npm/node_modules/pi-subagents/index.ts"
SUBAGENT_MANIFEST="$AGENT_DIR/npm/node_modules/pi-subagents/package.json"
SUBAGENT_LOCK="$AGENT_DIR/npm/package-lock.json"
SUBAGENT_CONFIG="$AGENT_DIR/extensions/subagent/config.json"
SUBAGENT_PROMPT_RUNTIME="$AGENT_DIR/npm/node_modules/pi-subagents/src/runs/shared/subagent-prompt-runtime.ts"
SUBAGENT_FANOUT_RUNTIME="$AGENT_DIR/npm/node_modules/pi-subagents/src/extension/fanout-child.ts"
CHILD_LAUNCHER="$AGENT_DIR/bin/pi-child"
CACHE_TTL_SECONDS=60
CACHE_DIR="$AGENT_DIR/cache/ox-driver-guard"
CURL_NETWORK_ARGS=(--connect-timeout 5 --max-time 20 --retry 2 --retry-all-errors)

fail() {
  printf 'Ox Driver guard: %s\n' "$1" >&2
  exit "${2:-4}"
}

clean_system() {
  local -a clean_args=(
    "HOME=${HOME:?HOME is required}"
    "PATH=${PATH:?PATH is required}"
    "TMPDIR=${TMPDIR:-/tmp}"
    "LANG=${LANG:-C}"
  )
  [[ -n "${SSL_CERT_FILE:-}" ]] && clean_args+=("SSL_CERT_FILE=$SSL_CERT_FILE")
  [[ -n "${SSL_CERT_DIR:-}" ]] && clean_args+=("SSL_CERT_DIR=$SSL_CERT_DIR")
  [[ -n "${NODE_EXTRA_CA_CERTS:-}" ]] && clean_args+=("NODE_EXTRA_CA_CERTS=$NODE_EXTRA_CA_CERTS")
  [[ -n "${CURL_CA_BUNDLE:-}" ]] && clean_args+=("CURL_CA_BUNDLE=$CURL_CA_BUNDLE")
  [[ -n "${HTTPS_PROXY:-}" ]] && clean_args+=("HTTPS_PROXY=$HTTPS_PROXY")
  [[ -n "${HTTP_PROXY:-}" ]] && clean_args+=("HTTP_PROXY=$HTTP_PROXY")
  [[ -n "${ALL_PROXY:-}" ]] && clean_args+=("ALL_PROXY=$ALL_PROXY")
  [[ -n "${NO_PROXY:-}" ]] && clean_args+=("NO_PROXY=$NO_PROXY")
  [[ -n "${https_proxy:-}" ]] && clean_args+=("https_proxy=$https_proxy")
  [[ -n "${http_proxy:-}" ]] && clean_args+=("http_proxy=$http_proxy")
  [[ -n "${all_proxy:-}" ]] && clean_args+=("all_proxy=$all_proxy")
  [[ -n "${no_proxy:-}" ]] && clean_args+=("no_proxy=$no_proxy")
  env -i "${clean_args[@]}" "$@"
}

require_runtime() {
  [[ -x "$REAL_PI" ]] || fail "real Pi executable is missing: $REAL_PI"
  [[ -f "$SAFETY_EXTENSION" ]] || fail "pi-safety extension is missing"
  [[ -f "$RESILIENCE_EXTENSION" ]] || fail "pi-resilience extension is missing"
  [[ -f "$SANDBOX_EXTENSION" ]] || fail "sandbox extension is missing"
  [[ -f "$SANDBOX_POLICY" && ! -L "$SANDBOX_POLICY" ]] || fail "sandbox policy is missing or symlinked"
  [[ -f "$SAFETY_POLICY" && ! -L "$SAFETY_POLICY" ]] || fail "capability policy is missing or symlinked"
  [[ -f "$SENSITIVE_PATHS" && ! -L "$SENSITIVE_PATHS" ]] || fail "sensitive-path helper is missing or symlinked"
  [[ -d "$AGENT_DIR/extensions/sandbox/node_modules/@anthropic-ai/sandbox-runtime" ]] ||
    fail "sandbox dependency is missing; run the documented npm ci command"
  command -v curl >/dev/null || fail "curl is required"
  command -v node >/dev/null || fail "Node.js is required"
  clean_system node -e '
    const fs = require("fs");
    const sandbox = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const safety = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
    const profiles = new Set(["power", "edit-only", "review-only"]);
    const expectedScope = safety.permissionProfile === "power" ? "home" : "project";
    const required = [".ssh", ".aws", ".kube", ".docker", ".codex", ".agents", ".claude", ".azure", ".config/gh", ".config/gcloud", ".config/opencode"];
    if (sandbox.enabled !== false || !["open", "restricted"].includes(sandbox.networkMode) ||
        !Array.isArray(sandbox.network?.allowedDomains) || !Array.isArray(sandbox.filesystem?.denyRead) ||
        !Array.isArray(sandbox.filesystem?.denyWrite) || required.some((entry) => !sandbox.filesystem.denyWrite.includes(entry)) ||
        (sandbox.networkMode === "restricted" && sandbox.network?.strictAllowlist !== true) || !Array.isArray(sandbox.filesystem?.allowWrite) ||
        !sandbox.filesystem.allowWrite.includes(".") || !profiles.has(safety.permissionProfile) ||
        safety.stealthTermsAcknowledged !== true ||
        safety.fileScope !== expectedScope) process.exit(1);
  ' "$SANDBOX_POLICY" "$SAFETY_POLICY" || fail "guard policy files have an invalid shape"
}

prepare_extensions() {
  EXTENSION_ARGS=(--no-extensions -e "$SAFETY_EXTENSION" -e "$RESILIENCE_EXTENSION" -e "$SANDBOX_EXTENSION")
  if [[ -f "$SUBAGENT_EXTENSION" && -f "$SUBAGENT_MANIFEST" ]]; then
    [[ ! -L "$AGENT_DIR/npm/node_modules/pi-subagents" &&
	   -f "$SUBAGENT_LOCK" && -f "$SUBAGENT_CONFIG" && -f "$SUBAGENT_PROMPT_RUNTIME" && -f "$SUBAGENT_FANOUT_RUNTIME" &&
       ! -L "$SUBAGENT_EXTENSION" && ! -L "$SUBAGENT_MANIFEST" &&
	   ! -L "$SUBAGENT_LOCK" && ! -L "$SUBAGENT_CONFIG" && ! -L "$SUBAGENT_PROMPT_RUNTIME" && ! -L "$SUBAGENT_FANOUT_RUNTIME" ]] ||
      fail "pinned pi-subagents runtime files are missing or symlinked"
    clean_system node -e '
      const fs = require("fs");
      const manifest = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const lock = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
      const config = JSON.parse(fs.readFileSync(process.argv[3], "utf8"));
      const pinned = lock.packages?.["node_modules/pi-subagents"];
      if (manifest.name !== "pi-subagents" || manifest.version !== "0.56.0" ||
          pinned?.version !== "0.56.0" || pinned?.integrity !== "sha512-XBmKqvrj4mCVQ6/uXiPqCmzHxGfBB+jjwmfNR3El+IfhnaJwZ+W6evXYRI3lQEXe6Nf56xfzUXQExIzE8cT5BQ==" ||
          config.maxSubagentDepth !== 2 || config.defaultSessionDir !== process.argv[4]) process.exit(1);
    ' "$SUBAGENT_MANIFEST" "$SUBAGENT_LOCK" "$SUBAGENT_CONFIG" "$AGENT_DIR/subagent-sessions" || fail "installed pi-subagents package identity, configuration, or registry integrity is outside policy"
    EXTENSION_ARGS+=(-e "$SUBAGENT_EXTENSION")
  elif [[ -f "$AGENT_DIR/agents/pi-lead.md" || -f "$AGENT_DIR/agents/pi-agent.md" || "$(basename "$0")" == "pi-child" ]]; then
    fail "team profiles require the pinned pi-subagents package"
  fi
}

prepare_cache() {
  local parent="$AGENT_DIR/cache"
  [[ ! -L "$parent" && ! -L "$CACHE_DIR" ]] || fail "cache path must not be a symlink"
  mkdir -p "$CACHE_DIR"
  [[ -d "$CACHE_DIR" && -O "$CACHE_DIR" ]] || fail "cache directory has an unsafe owner"
  chmod 700 "$parent" "$CACHE_DIR"
}

prepare_runtime_temp() {
  local runtime_tmp physical parent mode
  if [[ "$(basename "$0")" == "pi-child" ]]; then
    runtime_tmp="${OX_DRIVER_RUNTIME_TMP:-}"
    [[ -n "$runtime_tmp" ]] || fail "child runtime temporary directory is missing"
  else
    unset OX_DRIVER_RUNTIME_TMP
    runtime_tmp="$(mktemp -d /tmp/ox-driver-runtime.XXXXXX)"
    export OX_DRIVER_RUNTIME_OWNER=1
    export OX_DRIVER_RUNTIME_TMP="$runtime_tmp"
    trap cleanup_runtime_temp EXIT
    trap 'exit 130' HUP INT TERM
  fi
  [[ -d "$runtime_tmp" && ! -L "$runtime_tmp" && -O "$runtime_tmp" ]] || fail "runtime temporary directory has an unsafe owner or type"
  physical="$(cd "$runtime_tmp" && pwd -P)"
  parent="$(dirname "$physical")"
  [[ "$parent" == "/tmp" || "$parent" == "/private/tmp" ]] || fail "runtime temporary directory is outside the system temporary root"
  [[ "$(basename "$physical")" == ox-driver-runtime.* ]] || fail "runtime temporary directory has an invalid name"
  chmod 700 "$runtime_tmp"
  mode="$(file_mode "$runtime_tmp")" || fail "could not inspect runtime temporary directory permissions"
  [[ "$mode" == 700 ]] || fail "runtime temporary directory has unsafe permissions"
  export OX_DRIVER_RUNTIME_TMP="$physical"
  export TMPDIR="$physical"
}

file_mode() {
  case "$(uname -s)" in
    Darwin) stat -f %Lp "$1" ;;
    Linux) stat -c %a "$1" ;;
    *) return 1 ;;
  esac
}

cleanup_runtime_temp() {
  if [[ "${OX_DRIVER_RUNTIME_OWNER:-}" == 1 && -n "${OX_DRIVER_RUNTIME_TMP:-}" &&
        -d "$OX_DRIVER_RUNTIME_TMP" && ! -L "$OX_DRIVER_RUNTIME_TMP" && -O "$OX_DRIVER_RUNTIME_TMP" ]]; then
    case "$OX_DRIVER_RUNTIME_TMP" in
      /tmp/ox-driver-runtime.*|/private/tmp/ox-driver-runtime.*) rm -rf -- "$OX_DRIVER_RUNTIME_TMP" ;;
    esac
  fi
}

validate_cwd() {
  local current home
  current="$(pwd -P)"
  home="${HOME:?HOME is required}"
  if [[ "$(dirname "$current")" == "$home" && ! -d "$current/.git" &&
        ! -f "$current/package.json" && ! -f "$current/pyproject.toml" &&
        ! -f "$current/Cargo.toml" && ! -f "$current/go.mod" ]]; then
    fail "a direct child of the home directory needs a project marker: $current"
  fi
  case "$(dirname "$current")" in
    /Volumes|/mnt|/srv) fail "refusing a mount or service root as working directory: $current" ;;
  esac
  case "$current" in
    /|/bin|/bin/*|/sbin|/sbin/*|/System|/System/*|/Library|/Library/*|/Applications|/Applications/*|\
    /Users|/home|/Volumes|/dev|/dev/*|/proc|/proc/*|/sys|/sys/*|/run|/run/*|/boot|/boot/*|/mnt|/srv|\
    /etc|/etc/*|/private/etc|/private/etc/*|/usr|/usr/*|/opt|/opt/*|\
    /var|/private/var|/tmp|/private/tmp|"${TMPDIR:-/tmp}"|"$home"|"$AGENT_DIR"|"$AGENT_DIR/"*|"$home/.config"|"$home/.config/"*|\
    "$home/.ssh"|"$home/.ssh/"*|"$home/.aws"|"$home/.aws/"*|\
    "$home/.gnupg"|"$home/.gnupg/"*|"$home/.kube"|"$home/.kube/"*|\
    "$home/.docker"|"$home/.docker/"*|"$home/.codex"|"$home/.codex/"*|"$home/.agents"|"$home/.agents/"*|\
    "$home/.claude"|"$home/.claude/"*|"$home/.azure"|"$home/.azure/"*|\
    "$home/.config/gh"|"$home/.config/gh/"*|"$home/.config/gcloud"|"$home/.config/gcloud/"*|\
    "$home/Library/Keychains"|"$home/Library/Keychains/"*)
      fail "refusing broad or sensitive working directory: $current"
      ;;
  esac
}

prepare_clean_env() {
  local name
  CLEAN_ENV_ARGS=()
  while IFS= read -r name; do
    case "$name" in
      HOME|PATH|USER|LOGNAME|SHELL|TMPDIR|LANG|LANGUAGE|TZ|TERM|COLORTERM|NO_COLOR|FORCE_COLOR|\
      XDG_CONFIG_HOME|XDG_DATA_HOME|XDG_CACHE_HOME|XDG_STATE_HOME|SSL_CERT_FILE|SSL_CERT_DIR|NODE_EXTRA_CA_CERTS|CURL_CA_BUNDLE|\
      HTTPS_PROXY|HTTP_PROXY|ALL_PROXY|NO_PROXY|https_proxy|http_proxy|all_proxy|no_proxy|\
      PI_CODING_AGENT_DIR|PI_OFFLINE|PI_MODEL_EXCLUSIONS_PATH|PI_SUBAGENT_*|PI_SUBAGENTS_*|PI_INTERCOM_*|\
      OX_DRIVER_GUARD_READY|OX_DRIVER_ROOT_CWD|OX_DRIVER_ROOT_GIT_COMMON_DIR|OX_DRIVER_RUNTIME_TMP)
        CLEAN_ENV_ARGS+=("$name=${!name}")
        ;;
      LC_*)
        CLEAN_ENV_ARGS+=("$name=${!name}")
        ;;
    esac
  done < <(compgen -e)
}

canonical_git_common_dir() {
  local target
  command -v git >/dev/null || return 1
  target="$(clean_system git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [[ -d "$target" ]] || return 1
  (cd "$target" && pwd -P)
}

prepare_root_scope() {
  OX_DRIVER_ROOT_CWD="$(pwd -P)"
  export OX_DRIVER_ROOT_CWD
  if OX_DRIVER_ROOT_GIT_COMMON_DIR="$(canonical_git_common_dir "$OX_DRIVER_ROOT_CWD")"; then
    export OX_DRIVER_ROOT_GIT_COMMON_DIR
  else
    unset OX_DRIVER_ROOT_GIT_COMMON_DIR
  fi
}

validate_child_cwd() {
  local current root child_git
  current="$(pwd -P)"
  root="${OX_DRIVER_ROOT_CWD:-}"
  [[ -n "$root" && -d "$root" ]] || fail "child launch is missing the canonical root scope"
  root="$(cd "$root" && pwd -P)"
  case "$current" in
    "$root"|"$root"/*) return ;;
  esac
  if [[ -n "${OX_DRIVER_ROOT_GIT_COMMON_DIR:-}" ]] &&
     child_git="$(canonical_git_common_dir "$current")" &&
     [[ "$child_git" == "$OX_DRIVER_ROOT_GIT_COMMON_DIR" ]]; then
    return
  fi
  fail "child working directory is outside the root project or its linked worktrees: $current"
}

file_mtime() {
  case "$(uname -s)" in
    Darwin) stat -f %m "$1" ;;
    Linux) stat -c %Y "$1" ;;
    *) return 1 ;;
  esac
}

cache_fresh() {
  local modified now
  [[ -f "$1" && ! -L "$1" && -O "$1" ]] || return 1
  modified="$(file_mtime "$1")" || return 1
  now="$(date +%s)"
  (( now - modified < CACHE_TTL_SECONDS ))
}

catalog() {
  local cache="$CACHE_DIR/models.json" lock="$CACHE_DIR/models.lock" temp owner
  mkdir -p "$CACHE_DIR"
  chmod 700 "$CACHE_DIR"
  if cache_fresh "$cache"; then cat "$cache"; return; fi
  for _ in {1..200}; do
    if mkdir "$lock" 2>/dev/null; then
      printf '%s\n' "$$" >"$lock/owner"
      if cache_fresh "$cache"; then
        rm -f "$lock/owner"
        rmdir "$lock"
        cat "$cache"
        return
      fi
      temp="$(mktemp "$CACHE_DIR/models.XXXXXX")"
      chmod 600 "$temp"
      if clean_system curl -fsS "${CURL_NETWORK_ARGS[@]}" https://openrouter.ai/api/v1/models -o "$temp"; then
        mv "$temp" "$cache"
        rm -f "$lock/owner"
        rmdir "$lock"
        cat "$cache"
        return
      fi
      rm -f "$temp"
      rm -f "$lock/owner"
      rmdir "$lock"
      return 1
    fi
    owner="$(cat "$lock/owner" 2>/dev/null || true)"
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f "$lock/owner"
      rmdir "$lock" 2>/dev/null || true
      continue
    fi
    if [[ ! "$owner" =~ ^[0-9]+$ ]]; then
      local lock_mtime now
      lock_mtime="$(file_mtime "$lock")" || lock_mtime=0
      now="$(date +%s)"
      if (( now - lock_mtime > 2 )); then
        rm -f "$lock/owner"
        rmdir "$lock" 2>/dev/null || true
        continue
      fi
    fi
    cache_fresh "$cache" && { cat "$cache"; return; }
    sleep 0.05
  done
  return 1
}

check_free_route() {
  local response
  response="$(catalog)" || fail "could not verify the live model catalog; inspect the self-healing cache lock at $CACHE_DIR/models.lock" 3
  if ! printf '%s' "$response" | clean_system node -e '
    const fs = require("fs");
    const expected = process.argv[1];
    const body = JSON.parse(fs.readFileSync(0, "utf8"));
    const model = body.data?.find(item => item.id === expected);
    const prices = Object.values(model?.pricing ?? {});
    const isZeroPrice = value =>
      ((typeof value === "string" && value.trim() !== "") || typeof value === "number") &&
      Number.isFinite(Number(value)) && Number(value) === 0;
    const efforts = model?.reasoning?.supported_efforts ?? [];
    const parameters = model?.supported_parameters ?? [];
    if (!model || prices.length === 0 || !prices.every(isZeroPrice) ||
        !parameters.includes("tools") || !parameters.includes("reasoning_effort") || !efforts.includes("max")) {
      process.exit(1);
    }
  ' "$EXPECTED_MODEL"; then
    fail "the protected route is missing, paid, or lacks tools/max reasoning" 3
  fi
}

validate_child_args() {
  local arg value base model_count=0 prompt_runtime_count=0 fanout_runtime_count=0 tool_count=0
  local child_agent="${PI_SUBAGENT_CHILD_AGENT:-}" permission_profile
  [[ "${PI_SUBAGENT_CHILD:-0}" == "1" ]] || fail "child launch is missing the pi-subagents child marker"
  [[ "${PI_SUBAGENT_MAX_DEPTH:-}" == "2" ]] || fail "child launch has an invalid maximum depth"
  case "$child_agent:${PI_SUBAGENT_DEPTH:-}" in
    pi-lead:1|pi-agent:1|pi-agent:2) ;;
    *) fail "child role and depth are inconsistent" ;;
  esac
  [[ "$child_agent" == "pi-agent" || "$child_agent" == "pi-lead" ]] ||
    fail "protected children must use the installed pi-agent or pi-lead profile"
  [[ -f "$SAFETY_POLICY" && ! -L "$SAFETY_POLICY" ]] || fail "child capability policy is missing or symlinked"
  permission_profile="$(clean_system node -e '
    const fs = require("fs");
    const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    if (!["power", "edit-only", "review-only"].includes(value.permissionProfile)) process.exit(1);
    process.stdout.write(value.permissionProfile);
  ' "$SAFETY_POLICY")" || fail "child capability policy is invalid"
  if [[ "${PI_SUBAGENT_FANOUT_CHILD:-0}" == "1" ]]; then
    [[ "$child_agent" == "pi-lead" ]] || fail "only pi-lead may receive child fan-out"
  else
    [[ "$child_agent" == "pi-agent" ]] || fail "pi-lead must retain its fan-out runtime"
  fi
  while (( $# > 0 )); do
    arg="$1"
    case "$arg" in
      --sandbox|--sandbox=*|--no-sandbox|--no-sandbox=*|--models|--models=*)
        fail "child launch attempted to alter the protected runtime surface"
        ;;
      --no-extensions)
        ;;
      -e|--extension)
        shift
        (( $# > 0 )) || fail "extension flag has no value"
        value="$1"
        case "$value" in
          "$SUBAGENT_PROMPT_RUNTIME") ((prompt_runtime_count += 1)) ;;
          "$SUBAGENT_FANOUT_RUNTIME") ((fanout_runtime_count += 1)) ;;
          *) fail "child extension is outside the pinned pi-subagents runtime" ;;
        esac
        ;;
      -e=*|--extension=*)
        value="${arg#*=}"
        case "$value" in
          "$SUBAGENT_PROMPT_RUNTIME") ((prompt_runtime_count += 1)) ;;
          "$SUBAGENT_FANOUT_RUNTIME") ((fanout_runtime_count += 1)) ;;
          *) fail "child extension is outside the pinned pi-subagents runtime" ;;
        esac
        ;;
      --cwd|--cwd=*)
        fail "protected sessions must be started from their target working directory"
        ;;
      --api-key|--api-key=*)
        fail "plaintext API-key flags are disabled"
        ;;
      --tools|-t)
        shift
        (( $# > 0 )) || fail "tools flag has no value"
        validate_child_tools "$permission_profile" "$child_agent" "$1"
        ((tool_count += 1))
        ;;
      --tools=*|-t=*)
        validate_child_tools "$permission_profile" "$child_agent" "${arg#*=}"
        ((tool_count += 1))
        ;;
      --no-tools|-nt)
        ((tool_count += 1))
        ;;
      --system-prompt|--system-prompt=*|--skill|--skill=*|--prompt-template|--prompt-template=*|--theme|--theme=*|--use-theme|--use-theme=*|--approve|-a|--fork|--fork=*|--export|--export=*)
        fail "child launch attempted to load an unreviewed file or runtime override"
        ;;
      --append-system-prompt)
        shift
        (( $# > 0 )) || fail "append-system-prompt flag has no value"
        validate_child_temp_file "$1"
        ;;
      --append-system-prompt=*)
        validate_child_temp_file "${arg#*=}"
        ;;
      --session|--session-dir)
        shift
        (( $# > 0 )) || fail "session flag has no value"
        validate_child_session_path "$1"
        ;;
      --session=*|--session-dir=*)
        validate_child_session_path "${arg#*=}"
        ;;
      @*)
        validate_child_temp_file "${arg#@}"
        ;;
      --model|-m)
        shift
        (( $# > 0 )) || fail "model flag has no value"
        value="$1"
        ((model_count += 1))
        ;;
      --model=*|-m=*)
        value="${arg#*=}"
        ((model_count += 1))
        ;;
      --provider)
        shift
        (( $# > 0 )) || fail "provider flag has no value"
        [[ "$1" == "$EXPECTED_PROVIDER" ]] || fail "child provider is outside policy"
        ;;
      --provider=*)
        [[ "${arg#*=}" == "$EXPECTED_PROVIDER" ]] || fail "child provider is outside policy"
        ;;
      --thinking)
        shift
        (( $# > 0 )) || fail "thinking flag has no value"
        [[ "$1" == "$EXPECTED_THINKING" ]] || fail "child thinking is outside policy"
        ;;
      --thinking=*)
        [[ "${arg#*=}" == "$EXPECTED_THINKING" ]] || fail "child thinking is outside policy"
        ;;
    esac
    if [[ "$arg" == --model || "$arg" == -m || "$arg" == --model=* || "$arg" == -m=* ]]; then
      case "$value" in
        *:"$EXPECTED_THINKING") base="${value%:"$EXPECTED_THINKING"}" ;;
        *:*) fail "child model must use :$EXPECTED_THINKING" ;;
        *) fail "child model is missing :$EXPECTED_THINKING" ;;
      esac
      case "$base" in
        "$EXPECTED_MODEL"|"$EXPECTED_PROVIDER/$EXPECTED_MODEL") ;;
        *) fail "child model is outside policy" ;;
      esac
    fi
    shift
  done
  (( model_count == 1 )) || fail "child launch must contain one model selection"
  (( tool_count == 1 )) || fail "child launch must contain one explicit tool ceiling"
  (( prompt_runtime_count == 1 )) || fail "child launch must contain exactly one pinned prompt runtime"
  if [[ "${PI_SUBAGENT_FANOUT_CHILD:-0}" == "1" ]]; then
    (( fanout_runtime_count == 1 )) || fail "fanout child must contain exactly one pinned fanout runtime"
  else
    (( fanout_runtime_count == 0 )) || fail "leaf child must not load the fanout runtime"
  fi
}

validate_child_tools() {
  local profile="$1" child_agent="$2" list="$3" tool saw_subagent=0 saw_wait=0
  local -a tools
  [[ -n "$list" ]] || fail "child tool allowlist is empty"
  IFS=',' read -r -a tools <<<"$list"
  for tool in "${tools[@]}"; do
    if [[ "$tool" == "subagent" ]]; then
      saw_subagent=1
    elif [[ "$tool" == "subagent_wait" ]]; then
      saw_wait=1
    fi
    if [[ "$child_agent" == "pi-agent" && ( "$tool" == "subagent" || "$tool" == "subagent_wait" ) ]]; then
      fail "pi-agent leaves cannot receive delegation tools"
    fi
    case "$profile:$tool" in
      power:read|power:write|power:edit|power:bash|power:grep|power:find|power:ls|power:subagent|power:subagent_wait|power:contact_supervisor|power:structured_output|\
      edit-only:read|edit-only:write|edit-only:edit|edit-only:grep|edit-only:find|edit-only:ls|edit-only:subagent|edit-only:subagent_wait|edit-only:contact_supervisor|edit-only:structured_output|\
      review-only:read|review-only:grep|review-only:find|review-only:ls|review-only:subagent|review-only:subagent_wait|review-only:contact_supervisor|review-only:structured_output) ;;
      *) fail "child tool '$tool' exceeds the $profile capability profile" ;;
    esac
  done
  if [[ "$child_agent" == "pi-lead" && ( "$saw_subagent" != 1 || "$saw_wait" != 1 ) ]]; then
    fail "pi-lead must receive subagent and subagent_wait"
  fi
}

validate_child_temp_file() {
  local target="$1" parent temp_root
  [[ -f "$target" && ! -L "$target" && -O "$target" ]] || fail "child prompt file is missing, symlinked, or has an unsafe owner"
  parent="$(cd "$(dirname "$target")" && pwd -P)"
  temp_root="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
  case "$parent" in
    "$temp_root"/pi-subagent-*) ;;
    *) fail "child prompt file is outside the managed temporary directory" ;;
  esac
}

validate_child_session_path() {
  local target="$1" parent managed="$AGENT_DIR/subagent-sessions"
  [[ ! -L "$target" ]] || fail "child session target must not be a symlink"
  parent="$(dirname "$target")"
  [[ -d "$managed" && -d "$parent" && ! -L "$managed" && ! -L "$parent" ]] ||
    fail "child session directory is missing or symlinked"
  parent="$(cd "$parent" && pwd -P)"
  managed="$(cd "$managed" && pwd -P)"
  case "$parent" in
    "$managed"|"$managed"/*) ;;
    *) fail "child session path is outside the managed session directory" ;;
  esac
  if [[ -e "$target" ]]; then
    [[ -f "$target" && -O "$target" ]] || fail "existing child session target must be a regular owned file"
  fi
}

reject_root_model_overrides() {
  local arg
  case "${1:-}" in
    install|remove|uninstall|update|list|config|auth)
      fail "protected launcher does not expose Pi package or credential commands"
      ;;
  esac
  for arg in "$@"; do
    case "$arg" in
      --model|-m|--model=*|-m=*|--provider|--provider=*|--thinking|--thinking=*|--no-extensions|--sandbox|--sandbox=*|--no-sandbox|--no-sandbox=*|-e|--extension|-e=*|--extension=*|--models|--models=*|--api-key|--api-key=*|--cwd|--cwd=*|--approve|-a|--system-prompt|--system-prompt=*|--append-system-prompt|--append-system-prompt=*|--skill|--skill=*|--prompt-template|--prompt-template=*|--theme|--theme=*|--use-theme|--use-theme=*|--session|--session=*|--session-dir|--session-dir=*|--fork|--fork=*|--export|--export=*|--continue|-c|--resume|-r|@*)
        fail "protected launcher rejects policy overrides, API keys, alternate cwd, disabled extensions, and unreviewed file inputs"
        ;;
    esac
  done
}

require_runtime
prepare_cache
prepare_runtime_temp
if [[ "$(basename "$0")" == "pi-child" ]]; then
  validate_child_cwd
  validate_child_args "$@"
else
  while IFS= read -r protocol_name; do
    case "$protocol_name" in PI_SUBAGENT_*|PI_SUBAGENTS_*|PI_INTERCOM_*) unset "$protocol_name" ;; esac
  done < <(compgen -e)
  export PI_SUBAGENT_MAX_DEPTH=2
  validate_cwd
  prepare_root_scope
fi
prepare_extensions
export PI_CODING_AGENT_DIR="$AGENT_DIR"
export PI_SUBAGENT_PI_BINARY="$CHILD_LAUNCHER"
export PI_SUBAGENT_TASK_DELIVERY=file
export PI_SUBAGENT_MAX_DEPTH=2

if [[ "$(basename "$0")" == "pi-child" ]]; then
  check_free_route
  export OX_DRIVER_GUARD_READY=1
  prepare_clean_env
  exec env -i "${CLEAN_ENV_ARGS[@]}" "$REAL_PI" \
    --sandbox \
    --models "$EXPECTED_PROVIDER/$EXPECTED_MODEL:$EXPECTED_THINKING" \
    "${EXTENSION_ARGS[@]}" \
    "$@"
fi

reject_root_model_overrides "$@"
check_free_route
export OX_DRIVER_GUARD_READY=1
prepare_clean_env
env -i "${CLEAN_ENV_ARGS[@]}" "$REAL_PI" \
  --provider "$EXPECTED_PROVIDER" \
  --model "$EXPECTED_MODEL" \
  --thinking "$EXPECTED_THINKING" \
  --sandbox \
  --models "$EXPECTED_PROVIDER/$EXPECTED_MODEL:$EXPECTED_THINKING" \
  "${EXTENSION_ARGS[@]}" \
  "$@"
