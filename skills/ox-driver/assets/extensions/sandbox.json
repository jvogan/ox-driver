{
  "enabled": false,
  "networkMode": "open",
  "network": {
    "allowedDomains": [],
    "deniedDomains": [],
    "strictAllowlist": true
  },
  "filesystem": {
    "denyRead": [
      "~",
      "~/.ssh",
      "~/.aws",
      "~/.gnupg",
      "~/.kube",
      "~/.docker/config.json",
      "~/.git-credentials",
