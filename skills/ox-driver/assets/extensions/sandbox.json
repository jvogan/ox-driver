      "~/.npmrc",
      "~/.pypirc",
      "~/.pi/agent/auth.json",
      "~/.codex",
      "~/.agents",
      "~/.claude",
      "~/.azure",
      "~/.config/gh",
      "~/.config/gcloud",
      "~/.config/opencode",
      "~/Library/Keychains",
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      ".netrc",
      ".npmrc",
      ".pypirc",
      "auth.json",
      "credentials.json",
      "id_rsa",
      "id_ed25519",
      ".ssh",
      ".aws",
      ".gnupg",
      ".kube",
      ".docker",
      ".codex",
      ".agents",
      ".claude",
      ".azure",
      ".config/gh",
      ".config/gcloud",
      ".config/opencode"
    ],
    "allowRead": [
      "."
