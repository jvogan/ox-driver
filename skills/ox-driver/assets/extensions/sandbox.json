    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      ".git",
      ".git/**",
      ".pi",
      ".pi/**",
      ".ssh",
      ".aws",
      ".gnupg",
      ".kube",
      ".docker",
      ".codex",
      ".agents",
      ".claude",
      ".azure",
